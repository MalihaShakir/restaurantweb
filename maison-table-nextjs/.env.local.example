# ──────────────────────────────────────────────────────────────────────────────
# Maison Table — Environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Next.js / NextAuth ────────────────────────────────────────────────────────
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Create a free cluster at https://cloud.mongodb.com
# Replace <user>, <password>, and <cluster> with your Atlas credentials.
# Allow access from 0.0.0.0/0 in Atlas Network Access for Vercel deployments.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/maison?retryWrites=true&w=majority

# ── Restaurant ────────────────────────────────────────────────────────────────
# MongoDB ObjectId of the restaurant document — printed by the seed script.
# Run: npx tsx scripts/seed.ts
RESTAURANT_ID=

# ── Initial admin user (used by the seed script only) ─────────────────────────
# Change these before running the seed script in production.
ADMIN_EMAIL=admin@maisontable.example
ADMIN_PASSWORD=ChangeMe123!

# ── Stripe (online payments) ──────────────────────────────────────────────────
# Create an account at https://stripe.com
# Use test keys (sk_test_...) until you are ready for production.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Stripe webhook signing secret — from the Stripe Dashboard > Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Email (transactional notifications) ──────────────────────────────────────
# Recommended: Resend (https://resend.com) — generous free tier.
# Alternative: SendGrid, Postmark.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=orders@maisontable.example

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
